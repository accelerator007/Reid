{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reid",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_FUNCTIONS_URL": "https://pkogchbrknwmzefjklkr.supabase.co/functions/v1"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
